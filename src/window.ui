<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <requires lib="gtk" version="4.0"/>
  <requires lib="Adw" version="1.0"/>
  <requires lib="Gdk" version="1.0"/>
  <template class="ExbWindow" parent="AdwApplicationWindow">
    <property name="default-width">840</property>
    <property name="default-height">600</property>
    <property name="width-request">360</property>
    <property name="height-request">360</property>
    <property name="title" translatable="yes">Exhibit</property>
    <signal name="close-request" handler="on_close_request"/>
    <child>
      <object class="AdwBreakpoint">
        <condition>max-width: 700px</condition>
        <setter object="sidebar_menu" property="visible">False</setter>
        <setter object="close_sidebar_button" property="visible">True</setter>
        <setter object="sidebar_menu" property="visible">False</setter>
        <signal name="apply" handler="on_apply_breakpoint"/>
        <signal name="unapply" handler="on_unapply_breakpoint"/>
      </object>
    </child>
    <property name="content">
      <object class="GtkStack" id="stack">
        <property name="hexpand">True</property>
        <property name="vexpand">True</property>
        <child>
          <object class="GtkStackPage">
            <property name="name">startup_page</property>
            <property name="child">
              <object class="GtkStack">
                <property name="transition-duration">170</property>
                <property name="transition-type">crossfade</property>
                <style>
                  <class name="drop-target-remove-border"/>
                </style>
                <child>
                  <object class="GtkDropTarget" id="loading_drop_target">
                    <property name="actions">copy</property>
                    <signal name="drop" handler="on_drop_received"/>
                    <signal name="enter" handler="on_drop_enter"/>
                    <signal name="leave" handler="on_drop_leave"/>
                  </object>
                </child>
                <child>
                  <object class="GtkStackPage">
                    <property name="child">
                      <object class="AdwToolbarView">
                        <child type="top">
                          <object class="AdwHeaderBar">
                            <property name="title-widget">
                              <object class="GtkLabel">
                                <property name="label" translatable="yes">Exhibit</property>
                                <style>
                                  <class name="heading"/>
                                </style>
                              </object>
                            </property>
                            <child type="end">
                              <object class="GtkMenuButton">
                                <property name="primary">True</property>
                                <property name="icon-name">open-menu-symbolic</property>
                                <property name="tooltip-text" translatable="yes">Menu</property>
                                <property name="menu-model">minimal_menu</property>
                              </object>
                            </child>
                          </object>
                        </child>
                          <property name="content">
                            <object class="GtkStack" id="startup_stack">
                              <child>
                                <object class="GtkStackPage">
                                  <property name="child">
                                    <object class="AdwStatusPage">
                                      <property name="child">
                                        <object class="GtkBox">
                                          <property name="orientation">vertical</property>
                                          <property name="spacing">18</property>
                                          <property name="halign">center</property>
                                          <child>
                                            <object class="GtkButton">
                                              <style>
                                                <class name="pill"/>
                                                <class name="suggested-action"/>
                                              </style>
                                              <property name="halign">center</property>
                                              <property name="label" translatable="yes">Open Model</property>
                                              <signal name="clicked" handler="on_open_button_clicked"/>
                                            </object>
                                          </child>
                                          <child>
                                            <object class="GtkBox" id="recent_files_box">
                                              <property name="orientation">vertical</property>
                                              <property name="spacing">6</property>
                                              <property name="visible">False</property>
                                              <property name="width-request">320</property>
                                              <child>
                                                <object class="GtkLabel">
                                                  <property name="label" translatable="yes">Recent</property>
                                                  <property name="halign">start</property>
                                                  <property name="xalign">0</property>
                                                  <style>
                                                    <class name="heading"/>
                                                  </style>
                                                </object>
                                              </child>
                                              <child>
                                                <object class="GtkListBox" id="recent_files_list">
                                                  <property name="selection-mode">none</property>
                                                  <style>
                                                    <class name="boxed-list"/>
                                                  </style>
                                                </object>
                                              </child>
                                              <child>
                                                <object class="GtkButton" id="clear_recent_button">
                                                  <property name="halign">end</property>
                                                  <property name="label" translatable="yes">Clear Recent</property>
                                                  <signal name="clicked" handler="on_clear_recent_clicked"/>
                                                  <style>
                                                    <class name="flat"/>
                                                  </style>
                                                </object>
                                              </child>
                                            </object>
                                          </child>
                                        </object>
                                      </property>
                                      <property name="description" translatable="yes">Preview packed GLBs — meshopt, BasisU, armatures and clips. Open Folder (Ctrl+Shift+O) imports a directory; enable Restore Last Session in Loading to reopen tabs next launch.</property>
                                      <property name="hexpand">True</property>
                                      <property name="hexpand-set">True</property>
                                      <property name="icon-name">io.github.nokse22.Exhibit</property>
                                      <property name="title" translatable="yes">Exhibit</property>
                                      <property name="vexpand">True</property>
                                      <style>
                                        <class name="icon-dropshadow"/>
                                      </style>
                                    </object>
                                  </property>
                                </object>
                              </child>
                              <child>
                                <object class="GtkStackPage">
                                  <property name="child">
                                    <object class="AdwStatusPage">
                                      <property name="child">
                                        <object class="GtkButton">
                                          <style>
                                            <class name="pill"/>
                                            <class name="suggested-action"/>
                                          </style>
                                          <property name="halign">center</property>
                                          <property name="label" translatable="yes">Try Another</property>
                                          <signal name="clicked" handler="on_open_button_clicked"/>
                                        </object>
                                      </property>
                                      <property name="description" translatable="yes">Couldn't load the file</property>
                                      <property name="hexpand">True</property>
                                      <property name="hexpand-set">True</property>
                                      <property name="icon-name">dialog-warning-symbolic</property>
                                      <property name="title" translatable="yes">Error Loading File</property>
                                      <property name="vexpand">True</property>
                                    </object>
                                  </property>
                                <property name="name">error_page</property>
                              </object>
                            </child>
                          </object>
                        </property>
                      </object>
                    </property>
                    <property name="name">content</property>
                  </object>
                </child>
                <child>
                  <object class="GtkStackPage">
                    <property name="child">
                      <object class="AdwBin">
                        <style>
                          <class name="overlay-status"/>
                        </style>
                        <property name="child">
                          <object class="AdwStatusPage">
                            <property name="icon-name">arrow-into-box-symbolic</property>
                            <property name="title">Drop 3D Model to View</property>
                          </object>
                        </property>
                      </object>
                    </property>
                    <property name="name">drop</property>
                  </object>
                </child>
              </object>
            </property>
          </object>
        </child>
        <child>
          <object class="GtkStackPage">
            <property name="child">
              <object class="AdwOverlaySplitView" id="split_view">
                <property name="sidebar-width-fraction">0.35</property>
                <property name="sidebar-width-unit">px</property>
                <property name="max-sidebar-width">400</property>
                <property name="min-sidebar-width">300</property>
                <property name="show-sidebar">false</property>
                <signal name="notify::show-sidebar" handler="on_split_view_show_sidebar_changed"/>
                <property name="sidebar">
                  <object class="AdwToolbarView">
                    <property name="top-bar-style">flat</property>
                    <property name="bottom-bar-style">flat</property>
                    <property name="sensitive" bind-source="engine" bind-property="loading-file" bind-flags="invert-boolean">False</property>
                    <child type="top">
                      <object class="AdwHeaderBar">
                        <property name="title-widget">
                          <object class="AdwWindowTitle" id="title_widget">
                            <property name="title" translatable="yes">Exhibit</property>
                          </object>
                        </property>
                        <child type="end">
                          <object class="GtkButton" id="close_sidebar_button">
                            <property name="visible">False</property>
                            <style>
                              <class name="flat"/>
                            </style>
                            <property name="icon-name">left-large-symbolic</property>
                            <property name="tooltip-text" translatable="yes">Close Sidebar</property>
                            <signal name="clicked" handler="on_close_sidebar_clicked"/>
                          </object>
                        </child>
                        <child type="end">
                          <object class="GtkMenuButton" id="sidebar_menu">
                            <property name="icon-name">view-more-symbolic</property>
                            <property name="tooltip-text" translatable="yes">Menu</property>
                            <property name="menu-model">settings_menu</property>
                          </object>
                        </child>
                        <child type="start">
                          <object class="GtkMenuButton">
                            <property name="icon-name">view-more-symbolic</property>
                            <property name="tooltip-text" translatable="yes">Menu</property>
                            <property name="menu-model">settings_menu</property>
                            <property name="visible" bind-source="sidebar_menu" bind-property="visible" bind-flags="invert-boolean">False</property>
                          </object>
                        </child>
                      </object>
                    </child>
                    <child type="bottom">
                      <object class="AdwViewSwitcherBar">
                        <property name="stack">sidebar_stack</property>
                        <property name="reveal">True</property>
                      </object>
                    </child>
                    <property name="content">
                      <object class="GtkBox">
                        <property name="orientation">vertical</property>
                        <child>
                          <object class="AdwViewStack" id="sidebar_stack">
                            <property name="vexpand">true</property>
                            <child>
                              <object class="AdwViewStackPage">
                                <property name="name">render</property>
                                <property name="icon-name">photo-camera-symbolic</property>
                                <property name="title" translatable="yes">Render</property>
                                <property name="child">
                                  <object class="GtkScrolledWindow">
                                    <child>
                                      <object class="GtkBox">
                                        <property name="orientation">vertical</property>
                                        <property name="margin-start">12</property>
                                        <property name="margin-end">12</property>
                                        <property name="margin-bottom">24</property>
                                        <property name="spacing">24</property>
                                          <child>
                                          <object class="AdwPreferencesGroup">
                                            <property name="hexpand">True</property>
                                            <property name="hexpand-set">True</property>
                                            <property name="title" translatable="yes">Rendering</property>
                                            <child>
                                              <object class="AdwComboRow" id="translucency_switch">
                                                <property name="hexpand">True</property>
                                                <property name="hexpand-set">True</property>
                                                <property name="title" translatable="yes">Blending</property>
                                                <property name="selected" bind-source="engine" bind-property="blending" bind-flags="bidirectional | sync-create"></property>
                                                <property name="model">
                                                  <object class="AdwEnumListModel">
                                                    <property name="enum-type">ExbBlending</property>
                                                  </object>
                                                </property>
                                                <property name="expression">
                                                  <closure type="gchararray" function="enum_name" />
                                                </property>
                                              </object>
                                            </child>
                                            <child>
                                              <object class="AdwSwitchRow" id="tone_mapping_switch">
                                                <property name="hexpand">True</property>
                                                <property name="hexpand-set">True</property>
                                                <property name="title" translatable="yes">Tone Mapping</property>
                                                <property name="subtitle" translatable="yes">Map colors properly to the monitor colors</property>
                                                <property name="active" bind-source="engine" bind-property="tone-mapping" bind-flags="bidirectional | sync-create"></property>
                                              </object>
                                            </child>
                                            <child>
                                              <object class="AdwSwitchRow" id="hdri_ambient_switch">
                                                <property name="hexpand">True</property>
                                                <property name="hexpand-set">True</property>
                                                <property name="title" translatable="yes">Light with HDRI</property>
                                                <property name="subtitle" translatable="yes">Light the scene using a the loaded HDRI or the default</property>
                                                <property name="active" bind-source="engine" bind-property="hdri-ambient" bind-flags="bidirectional | sync-create"></property>
                                              </object>
                                            </child>
                                            <child>
                                              <object class="AdwSpinRow" id="light_intensity_spin">
                                                <property name="adjustment">
                                                  <object class="GtkAdjustment">
                                                    <property name="upper">50.0</property>
                                                    <property name="value" bind-source="engine" bind-property="light-intensity" bind-flags="bidirectional | sync-create">1.8</property>
                                                    <property name="step-increment">0.1</property>
                                                  </object>
                                                </property>
                                                <property name="hexpand">True</property>
                                                <property name="digits">1</property>
                                                <property name="hexpand-set">True</property>
                                                <property name="title" translatable="yes">Light Intensity</property>
                                              </object>
                                            </child>
                                          </object>
                                        </child>
                                        <child>
                                          <object class="AdwPreferencesGroup">
                                            <property name="hexpand">True</property>
                                            <property name="hexpand-set">True</property>
                                            <property name="title" translatable="yes">Effects</property>
                                            <property name="description" translatable="yes">Enable an effect, then expand to adjust its parameters</property>
                                            <child>
                                              <object class="AdwExpanderRow" id="ao_expander">
                                                <property name="title" translatable="yes">Ambient Occlusion</property>
                                                <property name="subtitle" translatable="yes">Approximate contact shadows (SSAO)</property>
                                                <property name="show-enable-switch">True</property>
                                                <property name="enable-expansion" bind-source="engine" bind-property="ambient-occlusion" bind-flags="bidirectional | sync-create">False</property>
                                                <child>
                                                  <object class="AdwSpinRow" id="ao_intensity_spin">
                                                    <property name="adjustment">
                                                      <object class="GtkAdjustment">
                                                        <property name="upper">3.0</property>
                                                        <property name="lower">0.0</property>
                                                        <property name="value" bind-source="engine" bind-property="ao-intensity" bind-flags="bidirectional | sync-create">1.0</property>
                                                        <property name="step-increment">0.1</property>
                                                      </object>
                                                    </property>
                                                    <property name="digits">2</property>
                                                    <property name="title" translatable="yes">Intensity</property>
                                                  </object>
                                                </child>
                                                <child>
                                                  <object class="AdwSpinRow" id="ao_radius_spin">
                                                    <property name="adjustment">
                                                      <object class="GtkAdjustment">
                                                        <property name="upper">5.0</property>
                                                        <property name="lower">0.1</property>
                                                        <property name="value" bind-source="engine" bind-property="ao-radius" bind-flags="bidirectional | sync-create">1.0</property>
                                                        <property name="step-increment">0.1</property>
                                                      </object>
                                                    </property>
                                                    <property name="digits">2</property>
                                                    <property name="title" translatable="yes">Radius</property>
                                                    <property name="subtitle" translatable="yes">Sample radius multiplier</property>
                                                  </object>
                                                </child>
                                                <child>
                                                  <object class="AdwSpinRow" id="ao_bias_spin">
                                                    <property name="adjustment">
                                                      <object class="GtkAdjustment">
                                                        <property name="upper">5.0</property>
                                                        <property name="lower">0.1</property>
                                                        <property name="value" bind-source="engine" bind-property="ao-bias" bind-flags="bidirectional | sync-create">1.0</property>
                                                        <property name="step-increment">0.1</property>
                                                      </object>
                                                    </property>
                                                    <property name="digits">2</property>
                                                    <property name="title" translatable="yes">Bias</property>
                                                    <property name="subtitle" translatable="yes">Self-occlusion bias multiplier</property>
                                                  </object>
                                                </child>
                                                <child>
                                                  <object class="AdwSpinRow" id="ao_kernel_spin">
                                                    <property name="adjustment">
                                                      <object class="GtkAdjustment">
                                                        <property name="upper">512</property>
                                                        <property name="lower">16</property>
                                                        <property name="value" bind-source="engine" bind-property="ao-kernel-size" bind-flags="bidirectional | sync-create">200</property>
                                                        <property name="step-increment">16</property>
                                                        <property name="page-increment">32</property>
                                                      </object>
                                                    </property>
                                                    <property name="digits">0</property>
                                                    <property name="title" translatable="yes">Samples</property>
                                                    <property name="subtitle" translatable="yes">Kernel size (higher = smoother, slower)</property>
                                                  </object>
                                                </child>
                                              </object>
                                            </child>
                                            <child>
                                              <object class="AdwExpanderRow" id="aa_expander">
                                                <property name="title" translatable="yes">Anti Aliasing</property>
                                                <property name="subtitle" translatable="yes">Smooth jagged edges — None disables</property>
                                                <property name="expanded">False</property>
                                                <child>
                                                  <object class="AdwComboRow" id="anti_aliasing_combo">
                                                    <property name="title" translatable="yes">Mode</property>
                                                    <property name="selected" bind-source="engine" bind-property="anti-aliasing" bind-flags="bidirectional | sync-create"></property>
                                                    <property name="model">
                                                      <object class="AdwEnumListModel">
                                                        <property name="enum-type">ExbAntiAliasing</property>
                                                      </object>
                                                    </property>
                                                    <property name="expression">
                                                      <closure type="gchararray" function="enum_name" />
                                                    </property>
                                                  </object>
                                                </child>
                                              </object>
                                            </child>
                                            <child>
                                              <object class="AdwExpanderRow" id="bloom_expander">
                                                <property name="title" translatable="yes">Bloom</property>
                                                <property name="subtitle" translatable="yes">Glow around bright areas</property>
                                                <property name="show-enable-switch">True</property>
                                                <property name="enable-expansion" bind-source="engine" bind-property="bloom" bind-flags="bidirectional | sync-create">False</property>
                                                <child>
                                                  <object class="AdwSpinRow" id="bloom_threshold_spin">
                                                    <property name="adjustment">
                                                      <object class="GtkAdjustment">
                                                        <property name="upper">1.0</property>
                                                        <property name="lower">0.0</property>
                                                        <property name="value" bind-source="engine" bind-property="bloom-threshold" bind-flags="bidirectional | sync-create">0.25</property>
                                                        <property name="step-increment">0.05</property>
                                                      </object>
                                                    </property>
                                                    <property name="digits">2</property>
                                                    <property name="title" translatable="yes">Threshold</property>
                                                    <property name="subtitle" translatable="yes">Minimum brightness that blooms</property>
                                                  </object>
                                                </child>
                                                <child>
                                                  <object class="AdwSpinRow" id="bloom_intensity_spin">
                                                    <property name="adjustment">
                                                      <object class="GtkAdjustment">
                                                        <property name="upper">5.0</property>
                                                        <property name="lower">0.0</property>
                                                        <property name="value" bind-source="engine" bind-property="bloom-intensity" bind-flags="bidirectional | sync-create">1.25</property>
                                                        <property name="step-increment">0.05</property>
                                                      </object>
                                                    </property>
                                                    <property name="digits">2</property>
                                                    <property name="title" translatable="yes">Intensity</property>
                                                  </object>
                                                </child>
                                                <child>
                                                  <object class="AdwSpinRow" id="bloom_radius_spin">
                                                    <property name="adjustment">
                                                      <object class="GtkAdjustment">
                                                        <property name="upper">16.0</property>
                                                        <property name="lower">1.0</property>
                                                        <property name="value" bind-source="engine" bind-property="bloom-radius" bind-flags="bidirectional | sync-create">5.0</property>
                                                        <property name="step-increment">0.5</property>
                                                      </object>
                                                    </property>
                                                    <property name="digits">1</property>
                                                    <property name="title" translatable="yes">Radius</property>
                                                    <property name="subtitle" translatable="yes">Blur spread in pixels</property>
                                                  </object>
                                                </child>
                                              </object>
                                            </child>
                                            <child>
                                              <object class="AdwExpanderRow" id="godrays_expander">
                                                <property name="title" translatable="yes">God Rays</property>
                                                <property name="subtitle" translatable="yes">Light shafts from bright regions</property>
                                                <property name="show-enable-switch">True</property>
                                                <property name="enable-expansion" bind-source="engine" bind-property="godrays" bind-flags="bidirectional | sync-create">False</property>
                                                <child>
                                                  <object class="AdwSpinRow" id="godrays_intensity_spin">
                                                    <property name="adjustment">
                                                      <object class="GtkAdjustment">
                                                        <property name="upper">5.0</property>
                                                        <property name="lower">0.0</property>
                                                        <property name="value" bind-source="engine" bind-property="godrays-intensity" bind-flags="bidirectional | sync-create">0.5</property>
                                                        <property name="step-increment">0.05</property>
                                                      </object>
                                                    </property>
                                                    <property name="digits">2</property>
                                                    <property name="title" translatable="yes">Intensity</property>
                                                  </object>
                                                </child>
                                                <child>
                                                  <object class="AdwSpinRow" id="godrays_decay_spin">
                                                    <property name="adjustment">
                                                      <object class="GtkAdjustment">
                                                        <property name="upper">1.0</property>
                                                        <property name="lower">0.8</property>
                                                        <property name="value" bind-source="engine" bind-property="godrays-decay" bind-flags="bidirectional | sync-create">0.94</property>
                                                        <property name="step-increment">0.01</property>
                                                      </object>
                                                    </property>
                                                    <property name="digits">2</property>
                                                    <property name="title" translatable="yes">Decay</property>
                                                    <property name="subtitle" translatable="yes">How fast shafts fade along the ray</property>
                                                  </object>
                                                </child>
                                                <child>
                                                  <object class="AdwSpinRow" id="godrays_density_spin">
                                                    <property name="adjustment">
                                                      <object class="GtkAdjustment">
                                                        <property name="upper">2.0</property>
                                                        <property name="lower">0.1</property>
                                                        <property name="value" bind-source="engine" bind-property="godrays-density" bind-flags="bidirectional | sync-create">1.0</property>
                                                        <property name="step-increment">0.05</property>
                                                      </object>
                                                    </property>
                                                    <property name="digits">2</property>
                                                    <property name="title" translatable="yes">Density</property>
                                                  </object>
                                                </child>
                                                <child>
                                                  <object class="AdwSpinRow" id="godrays_weight_spin">
                                                    <property name="adjustment">
                                                      <object class="GtkAdjustment">
                                                        <property name="upper">1.0</property>
                                                        <property name="lower">0.0</property>
                                                        <property name="value" bind-source="engine" bind-property="godrays-weight" bind-flags="bidirectional | sync-create">0.4</property>
                                                        <property name="step-increment">0.05</property>
                                                      </object>
                                                    </property>
                                                    <property name="digits">2</property>
                                                    <property name="title" translatable="yes">Weight</property>
                                                  </object>
                                                </child>
                                              </object>
                                            </child>
                                          </object>
                                        </child>
                                        <child>
                                          <object class="AdwPreferencesGroup">
                                            <property name="hexpand">True</property>
                                            <property name="hexpand-set">True</property>
                                            <property name="title" translatable="yes">Model Rendering</property>
                                            <child>
                                              <object class="AdwSwitchRow" id="edges_switch">
                                                <property name="hexpand">True</property>
                                                <property name="hexpand-set">True</property>
                                                <property name="title" translatable="yes">Show All Edges</property>
                                                <property name="active" bind-source="engine" bind-property="show-edges" bind-flags="bidirectional | sync-create"></property>
                                              </object>
                                            </child>
                                            <child>
                                              <object class="AdwSpinRow" id="edges_width_spin">
                                                <property name="hexpand">True</property>
                                                <property name="hexpand-set">True</property>
                                                <property name="title" translatable="yes">Edges Width</property>
                                                <property name="digits">1</property>
                                                <property name="adjustment">
                                                  <object class="GtkAdjustment">
                                                    <property name="lower">1</property>
                                                    <property name="upper">10</property>
                                                    <property name="value" bind-source="engine" bind-property="edges-width" bind-flags="bidirectional | sync-create">1</property>
                                                    <property name="step-increment">0.5</property>
                                                  </object>
                                                </property>
                                              </object>
                                            </child>
                                          </object>
                                        </child>
                                        <child>
                                          <object class="AdwPreferencesGroup" id="points_group">
                                            <child>
                                              <object class="AdwComboRow" id="point_sprites_type_combo">
                                                <property name="title" translatable="yes">Point Sprites Type</property>
                                                <property name="selected" bind-source="engine" bind-property="sprites" bind-flags="bidirectional | sync-create"></property>
                                                <property name="model">
                                                  <object class="AdwEnumListModel">
                                                    <property name="enum-type">ExbSprites</property>
                                                  </object>
                                                </property>
                                                <property name="expression">
                                                  <closure type="gchararray" function="enum_name" />
                                                </property>
                                              </object>
                                            </child>
                                            <child>
                                              <object class="AdwSpinRow" id="sprite_size_spin">
                                                <property name="title" translatable="yes">Sprite Size</property>
                                                <property name="adjustment">
                                                  <object class="GtkAdjustment">
                                                    <property name="lower">0</property>
                                                    <property name="upper">10</property>
                                                    <property name="value" bind-source="engine" bind-property="sprites-size" bind-flags="bidirectional | sync-create">1</property>
                                                    <property name="step-increment">1</property>
                                                  </object>
                                                </property>
                                              </object>
                                            </child>
                                            <child>
                                              <object class="AdwSpinRow" id="points_size_spin">
                                                <property name="title" translatable="yes">Points Size</property>
                                                <property name="adjustment">
                                                  <object class="GtkAdjustment">
                                                    <property name="lower">0</property>
                                                    <property name="upper">10</property>
                                                    <property name="value" bind-source="engine" bind-property="point-size" bind-flags="bidirectional | sync-create">1</property>
                                                    <property name="step-increment">1</property>
                                                  </object>
                                                </property>
                                              </object>
                                            </child>
                                          </object>
                                        </child>
                                      </object>
                                    </child>
                                  </object>
                                </property>
                              </object>
                            </child>
                            <child>
                              <object class="AdwViewStackPage">
                                <property name="name">model</property>
                                <property name="icon-name">shapes-symbolic</property>
                                <property name="title" translatable="yes">Model</property>
                                <property name="child">
                                  <object class="GtkScrolledWindow">
                                    <child>
                                      <object class="GtkBox">
                                        <property name="orientation">vertical</property>
                                        <property name="margin-start">12</property>
                                        <property name="margin-end">12</property>
                                        <property name="margin-bottom">24</property>
                                        <property name="spacing">24</property>
                                        <child>
                                          <object class="AdwPreferencesGroup" id="material_group">
                                            <property name="hexpand">True</property>
                                            <property name="hexpand-set">True</property>
                                            <property name="title" translatable="yes">Material</property>
                                            <child>
                                              <object class="AdwSpinRow" id="model_metallic_spin">
                                                <property name="hexpand">True</property>
                                                <property name="hexpand-set">True</property>
                                                <property name="title" translatable="yes">Model Metallic</property>
                                                <property name="digits">1</property>
                                                <property name="adjustment">
                                                  <object class="GtkAdjustment">
                                                    <property name="lower">0</property>
                                                    <property name="upper">1</property>
                                                    <property name="value" bind-source="engine" bind-property="model-metallic" bind-flags="bidirectional | sync-create">0</property>
                                                    <property name="step-increment">0.1</property>
                                                  </object>
                                                </property>
                                              </object>
                                            </child>
                                            <child>
                                              <object class="AdwSpinRow" id="model_roughness_spin">
                                                <property name="hexpand">True</property>
                                                <property name="hexpand-set">True</property>
                                                <property name="title" translatable="yes">Model Roughness</property>
                                                <property name="digits">1</property>
                                                <property name="adjustment">
                                                  <object class="GtkAdjustment">
                                                    <property name="lower">0</property>
                                                    <property name="upper">1</property>
                                                    <property name="value" bind-source="engine" bind-property="model-roughness" bind-flags="bidirectional | sync-create">0.3</property>
                                                    <property name="step-increment">0.1</property>
                                                  </object>
                                                </property>
                                              </object>
                                            </child>
                                            <child>
                                              <object class="AdwSpinRow" id="model_opacity_spin">
                                                <property name="hexpand">True</property>
                                                <property name="hexpand-set">True</property>
                                                <property name="title" translatable="yes">Model Opacity</property>
                                                <property name="digits">2</property>
                                                <property name="adjustment">
                                                  <object class="GtkAdjustment">
                                                    <property name="lower">0</property>
                                                    <property name="upper">1</property>
                                                    <property name="value" bind-source="engine" bind-property="model-opacity" bind-flags="bidirectional | sync-create">1</property>
                                                    <property name="step-increment">0.05</property>
                                                  </object>
                                                </property>
                                              </object>
                                            </child>
                                          </object>
                                        </child>
                                        <child>
                                          <object class="AdwPreferencesGroup" id="color_group">
                                            <property name="hexpand">True</property>
                                            <property name="hexpand-set">True</property>
                                            <property name="title" translatable="yes">Color</property>
                                            <child>
                                              <object class="AdwComboRow" id="model_scivis_component_combo">
                                                <property name="hexpand">True</property>
                                                <property name="selected">0</property>
                                                <property name="hexpand-set">True</property>
                                                <property name="title" translatable="yes">Coloration</property>
                                                <property name="model">
                                                  <object class="GtkStringList" id="coloration_list">
                                                    <items>
                                                      <item translatable="yes">Custom</item>
                                                      <item translatable="yes">Normal</item>
                                                      <item translatable="yes">Magnitude</item>
                                                      <item translatable="yes">Direct</item>
                                                    </items>
                                                  </object>
                                                </property>
                                              </object>
                                            </child>
                                            <child>
                                              <object class="AdwActionRow" id="model_color_row">
                                                <property name="hexpand">True</property>
                                                <property name="hexpand-set">True</property>
                                                <property name="title" translatable="yes">Model Color</property>
                                                <child>
                                                  <object class="GtkColorDialogButton" id="model_color_button">
                                                    <property name="valign">center</property>
                                                    <property name="rgba" bind-source="engine" bind-property="model-color" bind-flags="bidirectional | sync-create">rgb(246,97,81)</property>
                                                    <property name="dialog">
                                                      <object class="GtkColorDialog">
                                                        <property name="title" translatable="yes">Model Color</property>
                                                        <property name="with-alpha">False</property>
                                                      </object>
                                                    </property>
                                                  </object>
                                                </child>
                                              </object>
                                            </child>
                                          </object>
                                        </child>
                                        <child>
                                          <object class="AdwPreferencesGroup">
                                            <property name="title" translatable="yes">Inspect</property>
                                            <property name="description" translatable="yes">Overlays for asset review</property>
                                            <child>
                                              <object class="AdwSwitchRow" id="armature_switch">
                                                <property name="title" translatable="yes">Show Armature</property>
                                                <property name="subtitle" translatable="yes">X-ray skeleton (needs glTF skins; may reload)</property>
                                              </object>
                                            </child>
                                            <child>
                                              <object class="AdwSwitchRow" id="checkerboard_switch">
                                                <property name="title" translatable="yes">Checkerboard</property>
                                                <property name="subtitle" translatable="yes">Replace textures with UV checker (reload)</property>
                                              </object>
                                            </child>
                                            <child>
                                              <object class="AdwSwitchRow" id="normal_glyphs_switch">
                                                <property name="title" translatable="yes">Normal Glyphs</property>
                                                <property name="subtitle" translatable="yes">Vertex normal arrows (world-sized; disables depth)</property>
                                              </object>
                                            </child>
                                            <child>
                                              <object class="AdwSpinRow" id="normal_glyphs_scale_spin">
                                                <property name="title" translatable="yes">Glyph Scale</property>
                                                <property name="subtitle" translatable="yes">Arrow length relative to mesh size</property>
                                                <property name="digits">2</property>
                                                <property name="adjustment">
                                                  <object class="GtkAdjustment">
                                                    <property name="lower">0.05</property>
                                                    <property name="upper">5.0</property>
                                                    <property name="value">0.5</property>
                                                    <property name="step-increment">0.05</property>
                                                    <property name="page-increment">0.25</property>
                                                  </object>
                                                </property>
                                              </object>
                                            </child>
                                            <child>
                                              <object class="AdwSwitchRow" id="display_depth_switch">
                                                <property name="title" translatable="yes">Display Depth</property>
                                                <property name="subtitle" translatable="yes">Linearized depth colormap (opaque mesh required)</property>
                                              </object>
                                            </child>
                                            <child>
                                              <object class="AdwSwitchRow" id="skin_weights_switch">
                                                <property name="title" translatable="yes">Skin Weights</property>
                                                <property name="subtitle" translatable="yes">Color mesh by WEIGHTS_0 or selected joint heat</property>
                                              </object>
                                            </child>
                                            <child>
                                              <object class="AdwComboRow" id="skin_weights_mode_combo">
                                                <property name="title" translatable="yes">Weights Mode</property>
                                                <property name="subtitle" translatable="yes">Magnitude, influence slot, or bone heat</property>
                                                <property name="model">
                                                  <object class="GtkStringList">
                                                    <items>
                                                      <item translatable="yes">Magnitude</item>
                                                      <item translatable="yes">Slot 0 (primary)</item>
                                                      <item translatable="yes">Slot 1</item>
                                                      <item translatable="yes">Slot 2</item>
                                                      <item translatable="yes">Slot 3</item>
                                                      <item translatable="yes">Bone heat</item>
                                                    </items>
                                                  </object>
                                                </property>
                                              </object>
                                            </child>
                                            <child>
                                              <object class="AdwComboRow" id="skin_weights_joint_combo">
                                                <property name="title" translatable="yes">Joint</property>
                                                <property name="subtitle" translatable="yes">Bone for heat map (Bone heat mode)</property>
                                                <property name="sensitive">False</property>
                                              </object>
                                            </child>
                                            <child>
                                              <object class="AdwSwitchRow" id="stats_overlay_switch">
                                                <property name="title" translatable="yes">Show Stats</property>
                                                <property name="subtitle" translatable="yes">Height, verts, faces and scene counts</property>
                                              </object>
                                            </child>
                                          </object>
                                        </child>
                                  </object>
                                </child>
                              </object>
                            </property>
                          </object>
                        </child>
                        <child>
                          <object class="AdwViewStackPage">
                            <property name="name">scene</property>
                            <property name="icon-name">image-alt-symbolic</property>
                            <property name="title" translatable="yes">Scene</property>
                            <property name="child">
                              <object class="GtkScrolledWindow">
                                <child>
                                  <object class="GtkBox">
                                    <property name="orientation">vertical</property>
                                    <property name="margin-start">12</property>
                                    <property name="margin-end">12</property>
                                    <property name="margin-bottom">24</property>
                                    <property name="spacing">24</property>
                                    <child>
                                      <object class="AdwPreferencesGroup">
                                        <property name="hexpand">True</property>
                                        <property name="hexpand-set">True</property>
                                        <property name="title" translatable="yes">Grid</property>
                                        <child>
                                          <object class="AdwSwitchRow" id="grid_switch">
                                            <property name="hexpand">True</property>
                                            <property name="hexpand-set">True</property>
                                            <property name="title" translatable="yes">View Grid</property>
                                            <property name="active" bind-source="engine" bind-property="show-grid" bind-flags="bidirectional | sync-create"></property>
                                          </object>
                                        </child>
                                        <child>
                                          <object class="AdwSwitchRow" id="absolute_grid_switch">
                                            <property name="hexpand">True</property>
                                            <property name="hexpand-set">True</property>
                                            <property name="title" translatable="yes">Grid Absolute</property>
                                            <property name="active" bind-source="engine" bind-property="grid-absolute" bind-flags="bidirectional | sync-create"></property>
                                          </object>
                                        </child>
                                      </object>
                                    </child>
                                    <child>
                                      <object class="AdwPreferencesGroup">
                                        <property name="hexpand">True</property>
                                        <property name="hexpand-set">True</property>
                                        <property name="title" translatable="yes">Background</property>
                                        <child>
                                          <object class="AdwSwitchRow" id="use_skybox_switch">
                                            <property name="hexpand">True</property>
                                            <property name="hexpand-set">True</property>
                                            <property name="title" translatable="yes">HDRI as Background</property>
                                            <property name="subtitle" translatable="yes">Use the loaded HDRI or the default one as a background</property>
                                            <property name="active" bind-source="engine" bind-property="hdri-skybox" bind-flags="bidirectional | sync-create"></property>
                                          </object>
                                        </child>
                                        <child>
                                          <object class="FileRow" id="hdri_file_row">
                                            <property name="hexpand">True</property>
                                            <property name="hexpand-set">True</property>
                                            <property name="title" translatable="yes">HDRI Image</property>
                                            <property name="file" bind-source="engine" bind-property="hdri-file" bind-flags="bidirectional | sync-create"></property>
                                          </object>
                                        </child>
                                        <child>
                                          <object class="AdwSwitchRow" id="blur_switch">
                                            <property name="hexpand">True</property>
                                            <property name="hexpand-set">True</property>
                                            <property name="title" translatable="yes">Blur Background</property>
                                            <property name="active" bind-source="engine" bind-property="blur-background" bind-flags="bidirectional | sync-create"></property>
                                          </object>
                                        </child>
                                        <child>
                                          <object class="AdwSpinRow" id="blur_coc_spin">
                                            <property name="hexpand">True</property>
                                            <property name="hexpand-set">True</property>
                                            <property name="title" translatable="yes">Blur Circle Of Confusion</property>
                                            <property name="adjustment">
                                              <object class="GtkAdjustment">
                                                <property name="lower">5</property>
                                                <property name="upper">120</property>
                                                <property name="value" bind-source="engine" bind-property="blur-coc" bind-flags="bidirectional | sync-create">20</property>
                                                <property name="page-increment">10</property>
                                                <property name="step-increment">1</property>
                                              </object>
                                            </property>
                                          </object>
                                        </child>
                                      </object>
                                    </child>
                                    <child>
                                      <object class="AdwPreferencesGroup">
                                        <property name="hexpand">True</property>
                                        <property name="hexpand-set">True</property>
                                        <child>
                                          <object class="AdwSwitchRow" id="use_color_switch">
                                            <property name="hexpand">True</property>
                                            <property name="hexpand-set">True</property>
                                            <property name="title" translatable="yes">Use Custom Color</property>
                                            <property name="subtitle" translatable="yes">HDRI background takes priority over this</property>
                                          </object>
                                        </child>
                                        <child>
                                          <object class="AdwActionRow">
                                            <property name="hexpand">True</property>
                                            <property name="hexpand-set">True</property>
                                            <property name="title" translatable="yes">Background Color</property>
                                            <child>
                                              <object class="GtkColorDialogButton" id="background_color_button">
                                                <property name="valign">center</property>
                                                <property name="rgba" bind-source="engine" bind-property="background-color" bind-flags="bidirectional | sync-create">rgb(246,97,81)</property>
                                                <property name="dialog">
                                                  <object class="GtkColorDialog">
                                                    <property name="title" translatable="yes">Background Color</property>
                                                    <property name="with-alpha">False</property>
                                                  </object>
                                                </property>
                                              </object>
                                            </child>
                                          </object>
                                        </child>
                                      </object>
                                    </child>
                                  </object>
                                </child>
                              </object>
                            </property>
                          </object>
                        </child>
                        <child>
                          <object class="AdwViewStackPage">
                            <property name="name">more</property>
                            <property name="icon-name">applications-system-symbolic</property>
                            <property name="title" translatable="yes">More</property>
                            <property name="child">
                              <object class="GtkScrolledWindow">
                                <child>
                                  <object class="GtkBox">
                                    <property name="orientation">vertical</property>
                                    <property name="margin-start">12</property>
                                    <property name="margin-end">12</property>
                                    <property name="margin-bottom">24</property>
                                    <property name="spacing">24</property>
                                    <child>
                                      <object class="AdwPreferencesGroup">
                                        <property name="hexpand">True</property>
                                        <property name="hexpand-set">True</property>
                                        <property name="title" translatable="yes">Navigation</property>
                                        <child>
                                          <object class="AdwSwitchRow" id="point_up_switch">
                                            <property name="hexpand">True</property>
                                            <property name="hexpand-set">True</property>
                                            <property name="title" translatable="yes">Always Point Up</property>
                                            <!-- Wired to WindowSettings point-up in Python (multi-tab safe). -->
                                          </object>
                                        </child>
                                        <child>
                                          <object class="AdwComboRow" id="up_direction_combo">
                                            <property name="hexpand">True</property>
                                            <property name="hexpand-set">True</property>
                                            <property name="title" translatable="yes">Up Direction</property>
                                            <!-- Wired to WindowSettings up in Python (triggers reload). -->
                                            <property name="model">
                                              <object class="AdwEnumListModel">
                                                <property name="enum-type">ExbDirection</property>
                                              </object>
                                            </property>
                                            <property name="expression">
                                              <closure type="gchararray" function="enum_name" />
                                            </property>
                                          </object>
                                        </child>
                                      </object>
                                    </child>
                                    <child>
                                      <object class="AdwPreferencesGroup" id="animation_group">
                                        <property name="title" translatable="yes">Animation</property>
                                        <child>
                                          <object class="AdwComboRow" id="animation_combo">
                                            <property name="title" translatable="yes">Animation</property>
                                            <property name="model">
                                              <object class="GtkStringList" id="animation_combo_model">
                                              </object>
                                            </property>
                                          </object>
                                        </child>
                                        <child>
                                          <object class="AdwPreferencesRow">
                                            <child>
                                              <object class="GtkBox">
                                                <property name="margin-top">6</property>
                                                <property name="margin-bottom">6</property>
                                                <property name="margin-start">6</property>
                                                <property name="margin-end">6</property>
                                                <property name="spacing">6</property>
                                                <child>
                                                  <object class="GtkButton" id="play_button">
                                                    <property name="icon-name">media-playback-start-symbolic</property>
                                                    <property name="tooltip-text" translatable="yes">Play</property>
                                                    <property name="has-tooltip">true</property>
                                                  </object>
                                                </child>
                                                <child>
                                                  <object class="GtkScale" id="animation_time_scale">
                                                    <property name="digits">0</property>
                                                    <property name="hexpand">true</property>
                                                    <!-- Adjustment wired in Python to the active tab engine. -->
                                                  </object>
                                                </child>
                                              </object>
                                            </child>
                                          </object>
                                        </child>
                                      </object>
                                    </child>
                                    <child>
                                    <object class="AdwPreferencesGroup">
                                      <property name="hexpand">True</property>
                                      <property name="hexpand-set">True</property>
                                      <property name="title" translatable="yes">Loading</property>
                                      <child>
                                          <object class="AdwSwitchRow" id="automatic_settings_switch">
                                            <property name="hexpand">True</property>
                                            <property name="hexpand-set">True</property>
                                            <property name="title" translatable="yes">Automatic Settings</property>
                                            <property name="subtitle" translatable="yes">When loading choose the best presets for the file</property>
                                          </object>
                                        </child>
                                      <child>
                                          <object class="AdwSwitchRow" id="restore_session_switch">
                                            <property name="title" translatable="yes">Restore Last Session</property>
                                            <property name="subtitle" translatable="yes">Reopen the previous tabs on startup when no file is passed on the command line</property>
                                          </object>
                                        </child>
                                      <child>
                                          <object class="AdwSwitchRow" id="focus_existing_tab_switch">
                                            <property name="title" translatable="yes">Focus Existing Tab</property>
                                            <property name="subtitle" translatable="yes">Opening a model that is already open switches to that tab and flashes it instead of creating a duplicate</property>
                                          </object>
                                        </child>
                                      <child>
                                          <object class="AdwSwitchRow" id="automatic_reload_switch">
                                            <property name="hexpand">True</property>
                                            <property name="hexpand-set">True</property>
                                            <property name="title" translatable="yes">Reload On Change</property>
                                            <property name="subtitle" translatable="yes">Auto-reload the active tab when the file changes; other tabs show (modified) and ask</property>
                                          </object>
                                        </child>
                                      </object>
                                    </child>
                                  </object>
                                </child>
                              </object>
                            </property>
                          </object>
                        </child>
                      </object>
                    </child>
                  </object>
                </property>
              </object>
            </property>
            <property name="content">
              <object class="GtkStack">
                <property name="transition-duration">170</property>
                <property name="transition-type">crossfade</property>
                <style>
                  <class name="drop-target-remove-border"/>
                </style>
                <child>
                  <object class="GtkDropTarget" id="view_drop_target">
                    <property name="actions">copy</property>
                    <signal name="drop" handler="on_drop_received"/>
                    <signal name="enter" handler="on_drop_enter"/>
                    <signal name="leave" handler="on_drop_leave"/>
                  </object>
                </child>
                <child>
                  <object class="GtkStackPage">
                    <property name="child">
                      <object class="AdwToolbarView" id="toolbar_view">
                        <property name="top-bar-style">flat</property>
                        <property name="extend-content-to-top-edge">true</property>
                        <style>
                          <class name="main-view"/>
                        </style>
                        <child type="top">
                          <object class="AdwHeaderBar" id="header_bar">
                            <property name="show-title">False</property>
                            <style>
                              <class name="preview-headerbar"/>
                            </style>
                            <child type="start">
                              <object class="GtkBox" id="header_start_chrome">
                                <property name="orientation">horizontal</property>
                                <property name="spacing">6</property>
                                <property name="valign">center</property>
                                <property name="halign">start</property>
                                <style>
                                  <class name="header-start-chrome"/>
                                </style>
                                <child>
                                  <object class="GtkToggleButton" id="sidebar_toggle_button">
                                    <property name="icon-name">sidebar-show-symbolic</property>
                                    <property name="tooltip-text" translatable="yes">Reveal Sidebar</property>
                                    <property name="valign">center</property>
                                    <property name="active" bind-source="split_view" bind-property="show-sidebar" bind-flags="sync-create | bidirectional">True</property>
                                    <style>
                                      <class name="overlay-button"/>
                                      <class name="circular"/>
                                    </style>
                                  </object>
                                </child>
                                <child>
                                  <object class="GtkButton" id="home_button_headerbar">
                                    <property name="icon-name">go-home-symbolic</property>
                                    <property name="tooltip-text" translatable="yes">Reset to Bounds</property>
                                    <property name="valign">center</property>
                                    <signal name="clicked" handler="on_home_clicked"/>
                                    <style>
                                      <class name="overlay-button"/>
                                      <class name="circular"/>
                                    </style>
                                  </object>
                                </child>
                              </object>
                            </child>
                            <child type="end">
                              <object class="GtkMenuButton" id="primary_menu_button">
                                <property name="primary">True</property>
                                <property name="icon-name">open-menu-symbolic</property>
                                <property name="tooltip-text" translatable="yes">Menu</property>
                                <property name="menu-model">primary_menu</property>
                                <property name="valign">center</property>
                                <style>
                                  <class name="overlay-button"/>
                                  <class name="circular"/>
                                </style>
                              </object>
                            </child>
                          </object>
                        </child>
                        <child type="top">
                          <object class="AdwTabBar" id="tab_bar">
                            <property name="view">tab_view</property>
                            <property name="autohide">True</property>
                            <property name="expand-tabs">True</property>
                            <style>
                              <class name="exhibit-tab-bar"/>
                            </style>
                          </object>
                        </child>
                        <property name="content">
                          <object class="AdwToastOverlay" id="toast_overlay">
                            <property name="child">
                              <object class="GtkPaned" id="split_compare_main_paned">
                                <property name="orientation">horizontal</property>
                                <property name="wide-handle">True</property>
                                <property name="position">10000</property>
                                <property name="hexpand">True</property>
                                <property name="vexpand">True</property>
                                <property name="resize-start-child">True</property>
                                <property name="shrink-start-child">False</property>
                                <property name="resize-end-child">True</property>
                                <property name="shrink-end-child">True</property>
                                <property name="start-child">
                                  <object class="GtkOverlay" id="viewport_overlay">
                                    <property name="hexpand">True</property>
                                    <property name="vexpand">True</property>
                                    <property name="child">
                                      <object class="AdwTabView" id="tab_view">
                                        <property name="hexpand">True</property>
                                        <property name="vexpand">True</property>
                                      </object>
                                    </property>
                                    <!-- Seed holder first so engine exists for loading bind. -->
                                    <child type="overlay">
                                      <object class="GtkBox" id="seed_holder">
                                        <property name="visible">False</property>
                                        <child>
                                          <object class="ExbView" id="viewer">
                                            <property name="hexpand">True</property>
                                            <property name="vexpand">True</property>
                                            <property name="engine">
                                              <object class="ExbEngine" id="engine"/>
                                            </property>
                                          </object>
                                        </child>
                                      </object>
                                    </child>
                                    <child type="overlay">
                                      <object class="AdwStatusPage" id="loading_status_page">
                                        <property name="visible" bind-source="engine" bind-property="loading-file" bind-flags="sync-create">False</property>
                                        <property name="paintable">
                                          <object class="AdwSpinnerPaintable"/>
                                        </property>
                                        <property name="title">Loading</property>
                                      </object>
                                    </child>
                                    <child type="overlay">
                                      <object class="GtkBox" id="object_tree_overlay_shell">
                                        <property name="orientation">horizontal</property>
                                        <property name="spacing">8</property>
                                        <property name="halign">start</property>
                                        <property name="valign">start</property>
                                        <property name="visible">False</property>
                                        <!-- margin-top synced from header_bar height in TabsMixin. -->
                                        <property name="margin-top">0</property>
                                        <property name="margin-start">8</property>
                                        <property name="margin-bottom">8</property>
                                        <style>
                                          <class name="object-tree-overlay-shell"/>
                                        </style>
                                        <child>
                                          <object class="GtkToggleButton" id="object_tree_toggle">
                                            <property name="icon-name">view-list-symbolic</property>
                                            <property name="tooltip-text" translatable="yes">Outliner</property>
                                            <property name="halign">start</property>
                                            <property name="valign">start</property>
                                            <style>
                                              <class name="overlay-button"/>
                                              <class name="circular"/>
                                            </style>
                                          </object>
                                        </child>
                                        <child>
                                          <object class="GtkRevealer" id="object_tree_revealer">
                                            <property name="reveal-child" bind-source="object_tree_toggle" bind-property="active" bind-flags="sync-create | bidirectional">False</property>
                                            <property name="transition-type">slide-right</property>
                                            <property name="transition-duration">180</property>
                                            <property name="halign">start</property>
                                            <property name="valign">start</property>
                                            <child>
                                              <object class="GtkBox" id="object_tree_panel">
                                                <property name="orientation">vertical</property>
                                                <property name="spacing">6</property>
                                                <property name="width-request">300</property>
                                                <property name="height-request">420</property>
                                                <style>
                                                  <class name="object-tree-panel"/>
                                                  <class name="object-tree-overlay-panel"/>
                                                </style>
                                                <child>
                                                  <object class="GtkLabel">
                                                    <property name="label" translatable="yes">Outliner</property>
                                                    <property name="xalign">0</property>
                                                    <style>
                                                      <class name="heading"/>
                                                      <class name="object-tree-overlay-text"/>
                                                    </style>
                                                  </object>
                                                </child>
                                                <child>
                                                  <object class="GtkScrolledWindow">
                                                    <property name="hexpand">True</property>
                                                    <property name="vexpand">True</property>
                                                    <property name="hscrollbar-policy">automatic</property>
                                                    <property name="vscrollbar-policy">automatic</property>
                                                    <style>
                                                      <class name="object-tree-scroll"/>
                                                    </style>
                                                    <child>
                                                      <object class="GtkListView" id="object_tree_view">
                                                        <property name="hexpand">True</property>
                                                        <property name="vexpand">True</property>
                                                        <property name="single-click-activate">False</property>
                                                        <property name="show-separators">False</property>
                                                        <style>
                                                          <class name="object-tree-view"/>
                                                        </style>
                                                      </object>
                                                    </child>
                                                  </object>
                                                </child>
                                              </object>
                                            </child>
                                          </object>
                                        </child>
                                      </object>
                                    </child>
                                  </object>
                                </property>
                                <property name="end-child">
                                  <object class="GtkRevealer" id="split_compare_revealer">
                                    <property name="reveal-child">False</property>
                                    <property name="transition-type">slide-left</property>
                                    <property name="vexpand">True</property>
                                    <property name="hexpand">True</property>
                                    <child>
                                      <object class="GtkBox" id="split_compare_column">
                                        <property name="orientation">vertical</property>
                                        <property name="spacing">6</property>
                                        <property name="margin-top">6</property>
                                        <property name="margin-bottom">6</property>
                                        <property name="margin-start">8</property>
                                        <property name="margin-end">8</property>
                                        <property name="width-request">280</property>
                                        <property name="hexpand">True</property>
                                        <property name="vexpand">True</property>
                                        <child>
                                          <object class="GtkBox">
                                            <property name="orientation">horizontal</property>
                                            <property name="spacing">12</property>
                                            <child>
                                              <object class="GtkLabel" id="split_compare_primary_label">
                                                <property name="wrap">True</property>
                                                <property name="xalign">0</property>
                                                <property name="hexpand">True</property>
                                                <property name="label" translatable="yes">Secondary status</property>
                                              </object>
                                            </child>
                                            <child>
                                              <object class="GtkCheckButton" id="split_compare_pin_check">
                                                <property name="label" translatable="yes">Pin secondary model</property>
                                                <property name="valign">center</property>
                                              </object>
                                            </child>
                                            <child>
                                              <object class="GtkButton" id="split_compare_swap_button">
                                                <property name="label" translatable="yes">Swap</property>
                                                <property name="valign">center</property>
                                                <property name="action-name">win.split-compare-swap</property>
                                                <property name="tooltip-text" translatable="yes">Swap active and pinned models</property>
                                              </object>
                                            </child>
                                          </object>
                                        </child>
                                        <child>
                                          <object class="GtkPaned" id="split_compare_paned">
                                            <property name="orientation">vertical</property>
                                            <property name="wide-handle">False</property>
                                            <property name="position">0</property>
                                            <property name="hexpand">True</property>
                                            <property name="vexpand">True</property>
                                            <property name="start-child">
                                              <object class="GtkBox">
                                                <property name="visible">False</property>
                                                <property name="height-request">0</property>
                                              </object>
                                            </property>
                                            <property name="end-child">
                                              <object class="GtkLabel" id="split_compare_stub">
                                                <property name="label" translatable="yes">Secondary (stub)</property>
                                              </object>
                                            </property>
                                          </object>
                                        </child>
                                      </object>
                                    </child>
                                  </object>
                                </property>
                              </object>
                            </property>
                          </object>
                        </property>
                      </object>
                    </property>
                    <property name="name">content</property>
                    <property name="visible">False</property>
                  </object>
                </child>
                <child>
                  <object class="GtkStackPage">
                    <property name="child">
                      <object class="AdwBin">
                        <style>
                          <class name="overlay-status"/>
                        </style>
                        <property name="child">
                          <object class="AdwStatusPage">
                            <property name="icon-name">arrow-into-box-symbolic</property>
                            <property name="title">Drop 3D Model or HDRI</property>
                          </object>
                        </property>
                      </object>
                    </property>
                    <property name="name">drop</property>
                  </object>
                </child>
              </object>
            </property>
          </object>
              </property>
            <property name="name">3d_page</property>
          </object>
        </child>
      </object>
    </property>
  </template>
  <object class="SettingsDialog" id="settings_dialog"/>
  <menu id="primary_menu">
    <section>
      <item>
        <attribute name="custom">theme</attribute>
      </item>
    </section>
    <section>
      <item>
        <attribute name="label" translatable="yes">_New Window</attribute>
        <attribute name="action">app.open-new-window</attribute>
      </item>
      <item>
        <attribute name="label" translatable="yes">_Load New File</attribute>
        <attribute name="action">win.open-new</attribute>
      </item>
      <item>
        <attribute name="label" translatable="yes">_Open Folder</attribute>
        <attribute name="action">win.open-folder</attribute>
      </item>
      <item>
        <attribute name="label" translatable="yes">_Export Image</attribute>
        <attribute name="action">win.save-as-image</attribute>
      </item>
      <item>
        <attribute name="label" translatable="yes">_Open Externally</attribute>
        <attribute name="action">app.open-external</attribute>
      </item>
      <item>
        <attribute name="label" translatable="yes">_Preferences</attribute>
        <attribute name="action">win.preferences</attribute>
      </item>
    </section>
    <section>
      <item>
        <attribute name="label" translatable="yes">_Help</attribute>
        <attribute name="action">app.help</attribute>
      </item>
      <item>
        <attribute name="label" translatable="yes">_Keyboard Shortcuts</attribute>
        <attribute name="action">app.shortcuts</attribute>
      </item>
      <item>
        <attribute name="label" translatable="yes">_About Exhibit</attribute>
        <attribute name="action">app.about</attribute>
      </item>
    </section>
  </menu>
  <menu id="settings_menu">
    <section id="settings_section">
    </section>
    <section>
      <item>
        <attribute name="label" translatable="yes">Save Current Settings</attribute>
        <attribute name="action">win.save-settings</attribute>
      </item>
    </section>
    <section>
      <item>
        <attribute name="label" translatable="yes">Orthonographic</attribute>
        <attribute name="action">win.orthographic</attribute>
      </item>
      <item>
        <attribute name="label" translatable="yes">Sync Cameras Across Tabs</attribute>
        <attribute name="action">win.sync-cameras</attribute>
      </item>
      <item>
        <attribute name="label" translatable="yes">Split Compare (Experimental)</attribute>
        <attribute name="action">win.split-compare</attribute>
      </item>
      <item>
        <attribute name="label" translatable="yes">Swap Active ↔ Pinned</attribute>
        <attribute name="action">win.split-compare-swap</attribute>
      </item>
    </section>
    <section>
      <item>
        <attribute name="label" translatable="yes">Open HDRI Folder</attribute>
        <attribute name="action">app.open-hdri-folder</attribute>
      </item>
      <item>
        <attribute name="label" translatable="yes">Open Configurations Folder</attribute>
        <attribute name="action">app.open-configs-folder</attribute>
      </item>
    </section>
  </menu>
  <menu id="minimal_menu">
    <section>
      <item>
        <attribute name="label" translatable="yes">_New Window</attribute>
        <attribute name="action">app.open-new-window</attribute>
      </item>
    </section>
    <section>
      <item>
        <attribute name="label" translatable="yes">_Help</attribute>
        <attribute name="action">app.help</attribute>
      </item>
      <item>
        <attribute name="label" translatable="yes">_Keyboard Shortcuts</attribute>
        <attribute name="action">app.shortcuts</attribute>
      </item>
      <item>
        <attribute name="label" translatable="yes">_About Exhibit</attribute>
        <attribute name="action">app.about</attribute>
      </item>
    </section>
  </menu>
</interface>

