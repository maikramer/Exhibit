+void vtkF3DRenderer::SetSSAORadiusMultiplier(double multiplier)
+{
+  if (this->SSAORadiusMultiplier != multiplier)
+  {
+    this->SSAORadiusMultiplier = multiplier;
+    this->RenderPassesConfigured = false;
+  }
+}
+
+//----------------------------------------------------------------------------
+void vtkF3DRenderer::SetSSAOBiasMultiplier(double multiplier)
+{
+  if (this->SSAOBiasMultiplier != multiplier)
+  {
+    this->SSAOBiasMultiplier = multiplier;
+    this->RenderPassesConfigured = false;
+  }
+}
+
+//----------------------------------------------------------------------------
+void vtkF3DRenderer::SetSSAOKernelSize(int kernelSize)
+{
+  if (this->SSAOKernelSize != kernelSize)
+  {
+    this->SSAOKernelSize = kernelSize;
+    this->RenderPassesConfigured = false;
+  }
+}
+
+//----------------------------------------------------------------------------
+void vtkF3DRenderer::SetSSAOIntensity(double intensity)
+{
+  if (this->SSAOIntensity != intensity)
+  {
+    this->SSAOIntensity = intensity;
+    this->RenderPassesConfigured = false;
+  }
+}
